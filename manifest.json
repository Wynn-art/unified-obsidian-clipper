{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "Unified Obsidian Clipper",
  "version": "0.0.1",
  "minimum_chrome_version": "116",
  "description": "Save YouTube & Bilibili videos and web pages to Obsidian with transcripts, AI summaries, highlights, and web clipping.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "commands",
    "contextMenus",
    "declarativeNetRequest",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.supadata.ai/*",
    "https://api.deepseek.com/*",
    "http://127.0.0.1:27123/*",
    "http://localhost:27123/*",
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.hdslb.com/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://localhost/*",
    "https://localhost/*",
    "http://*/*",
    "https://*/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/list/watchlater",
        "https://www.bilibili.com/list/watchlater/*"
      ],
      "js": ["bilibili/content.js"],
      "css": ["bilibili/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["web/browser-polyfill.min.js", "web/content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Unified Obsidian Clipper",
    "default_popup": "web/popup.html",
    "default_icon": {
      "16": "youtube/icons/icon16.png",
      "48": "youtube/icons/icon48.png",
      "128": "youtube/icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "youtube/sidepanel.html"
  },
  "options_ui": {
    "page": "web/settings.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "youtube/icons/icon16.png",
    "48": "youtube/icons/icon48.png",
    "128": "youtube/icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+O", "mac": "Command+Shift+O" },
      "description": "__MSG_commandOpenClipper__"
    },
    "quick_clip": {
      "suggested_key": { "default": "Alt+Shift+O", "mac": "Alt+Shift+O" },
      "description": "__MSG_commandQuickClip__"
    },
    "toggle_highlighter": {
      "suggested_key": { "default": "Alt+Shift+H", "mac": "Alt+Shift+H" },
      "description": "__MSG_commandToggleHighlighter__"
    },
    "toggle_reader": {
      "suggested_key": { "default": "Alt+Shift+R", "mac": "Alt+Shift+R" },
      "description": "__MSG_commandToggleReader__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "web/reader.css",
        "web/reader-script.js",
        "web/browser-polyfill.min.js",
        "web/style.css",
        "web/side-panel.html",
        "web/flatten-shadow-dom.js",
        "web/highlighter.css"
      ],
      "matches": ["*://*/*"]
    }
  ]
}
